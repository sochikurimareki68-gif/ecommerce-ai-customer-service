    { "id": "FC08", "input": "枕芯可以7天无理由退货吗？", "expect_all": ["枕芯"], "expect_any": ["不支持", "非质量", "贴身"], "must_not": ["枕芯支持7天无理由", "可以直接退"] },
    { "id": "FC09", "input": "满减能和优惠券叠加吗？", "expect_all": ["叠加"], "expect_any": ["满减", "优惠券"], "must_not": ["不能叠加", "不可叠加", "不支持叠加"] },
    { "id": "FC10", "input": "1.8米的四件套多少钱？", "expect_all": ["1.8"], "expect_any": ["299", "349", "459", "599", "899", "价格", "参考"], "must_not": ["免费", "0元", "1999"] },
    { "id": "FC11", "input": "超过承诺时间没发货有补偿吗？", "expect_all": ["5"], "expect_any": ["48", "补偿", "券"], "must_not": ["10元", "20元", "50元"] },
    { "id": "FC12", "input": "床品面料有荧光剂吗？", "expect_all": ["不含"], "expect_any": ["OEKO", "荧光剂"], "must_not": ["含少量", "微量荧光", "有少量"] }
  ],
