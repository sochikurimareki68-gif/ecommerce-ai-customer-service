{
  "_comment": "项目一 v1.3 效果评测数据集。expect_branch 是期望命中的对话流分支；expect_any 是回复中至少应出现其一的关键词（用于校验内容是否答到点上）。",
  "_branch_keywords_comment": "用于从回复文本反推实际走了哪条分支（因为对话流的分类结果不对外暴露）。命中数最多者判为该分支。",
  "branch_keywords": {
    "商品咨询": ["尺寸", "被套", "床单", "枕", "材质", "面料", "规格", "克重", "支数", "颜色", "款式", "推荐", "套件"],
    "洗护指南": ["洗涤", "清洗", "水温", "晾晒", "晾干", "机洗", "洗衣机", "洗涤剂", "缩水", "起球", "保养", "浸泡", "烘干", "洗"],
    "物流发货": ["发货", "快递", "物流", "48", "运费", "包邮", "签收", "到货", "运输", "配送"],
    "退换售后": ["退货", "换货", "退款", "售后", "7天", "无理由", "寄回", "验货", "退货流程"],
    "优惠活动": ["满减", "优惠券", "折扣", "领券", "满199", "活动价", "积分", "会员", "活动"],
    "其他兜底": ["正在为您转接", "欢迎来到优眠家居", "回答不了", "帮不了", "议价", "智能客服小助手", "转接人工"]
  },
  "forbidden": ["<parameter", "我是人工客服", "```", "<function", "user_message"],
  "_multi_turn_comment": "多轮用例：同一 cookie 会话连发 turns 里的两句，只校验第二轮是否命中 expect_any（证明读懂了上文），由 run_eval.py --multi 执行，结果写入 eval/report-multi.md。",
  "multi_turn_cases": [
    { "id": "M01", "turns": ["天丝床品怎么洗？", "那纯棉的呢？"], "expect_any": ["纯棉", "40"] },
    { "id": "M02", "turns": ["四件套有什么尺寸？", "1.8 米多少钱？"], "expect_any": ["1.8", "899", "599", "499"] },
    { "id": "M03", "turns": ["我想退货", "运费谁出？"], "expect_any": ["运费", "承担"] },
    { "id": "M04", "turns": ["多久能发货？", "新疆发吗？"], "expect_any": ["新疆", "EMS", "偏远"] },
    { "id": "M05", "turns": ["现在有什么活动？", "能叠加吗？"], "expect_any": ["叠加"] }
  ],
  "_memory_comment": "记忆回归用例（M-4）：同一会话连发 6 句，第 1 句埋关键信息、中间 4 句干扰、第 6 句追问。判定：命中 expect_any 且无编造=答对；明确说没记住=达标；出现 must_not 或错误数字=编造，既没答对也没说没记住=跑题，后两种判失败。digit_width 用于自动揪出编造的数字。由 run_eval.py --memory 执行，结果写入 eval/report-memory.md。",
  "memory_cases": [
    {
      "id": "MEM01",
      "dim": "order_no 订单尾号",
      "turns": [
        "我买的1.8米有机棉四件套，订单尾号3829，什么时候发货？",
        "物流一般几天能到？",
        "支持七天无理由退换吗？",
        "最近有什么满减活动？",
        "被套掉色怎么处理？",
        "帮我回忆一下，我前面说的订单尾号是多少？"
      ],
      "expect_any": ["3829"],
      "digit_width": 4,
      "must_not": []
    },
    {
      "id": "MEM02",
      "dim": "bed_size 床型",
      "turns": [
        "我要买的床是1.8米的，有机棉四件套有合适的吗？",
        "被套掉色怎么处理？",
        "多久能发货？",
        "支持七天无理由退换吗？",
        "最近有什么满减活动？",
        "那我前面说的床是几米的？"
      ],
      "expect_any": ["1.8"],
      "must_not": ["1.5米", "1.5 米", "1.2米", "2.0米", "1.5m"]
    }
  ],
  "_fact_comment": "事实一致性用例（v1.9）：expect_all 必须全部命中，must_not 命中任何一个即判编造/答错，expect_any 为软性命中（可选）。断言全部来自 docs/faq-knowledge-base.md 与 docs/product-catalog.md 的原文事实，由 run_eval.py --facts 执行，结果写入 eval/report-facts.md。",
  "fact_cases": [
