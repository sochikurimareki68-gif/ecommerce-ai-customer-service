    { "id": "P02", "expect_branch": "商品咨询", "input": "你们的被芯是什么材质的？", "expect_any": ["材质", "填充", "面料", "棉"] },
    { "id": "P03", "expect_branch": "商品咨询", "input": "1.8米的床应该选多大尺寸？", "expect_any": ["尺寸", "cm", "被套"] },
    { "id": "P04", "expect_branch": "商品咨询", "input": "我想买一套床品，有什么推荐？", "expect_any": ["推荐", "套件", "建议"] },
    { "id": "P05", "expect_branch": "商品咨询", "input": "枕芯和枕套有什么区别？", "expect_any": ["枕"] },

    { "id": "W01", "expect_branch": "洗护指南", "input": "纯棉床品怎么洗？", "expect_any": ["洗", "水温", "洗涤"] },
    { "id": "W02", "expect_branch": "洗护指南", "input": "床单多久洗一次比较好？", "expect_any": ["洗", "周", "更换"] },
    { "id": "W03", "expect_branch": "洗护指南", "input": "被套可以用洗衣机洗吗？", "expect_any": ["机洗", "洗衣机", "轻柔"] },
    { "id": "W04", "expect_branch": "洗护指南", "input": "洗完之后缩水了怎么办？", "expect_any": ["缩水", "洗", "恢复", "拉伸"] },
    { "id": "W05", "expect_branch": "洗护指南", "input": "床品晾晒要注意什么？", "expect_any": ["晾", "晒", "阴凉", "暴晒"] },

    { "id": "L01", "expect_branch": "物流发货", "input": "多久能发货？", "expect_any": ["发货", "48"] },
    { "id": "L02", "expect_branch": "物流发货", "input": "发什么快递？", "expect_any": ["快递", "物流"] },
    { "id": "L03", "expect_branch": "物流发货", "input": "包邮吗？", "expect_any": ["包邮", "运费"] },
    { "id": "L04", "expect_branch": "物流发货", "input": "我的订单到哪了？", "expect_any": ["订单", "物流", "快递"] },
