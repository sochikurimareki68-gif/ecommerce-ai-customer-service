# 优眠小助手 后端代理 · 环境变量示例
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交到 GitHub）
# 所有变量都有默认值，下面只列出需要覆盖的场景。

# ---------- 必须配置 ----------

# 扣子个人访问令牌（PAT，pat_ 开头）
# 生成地址：https://www.coze.cn/open  →  个人访问令牌
# 必须勾选：Chat（对话）
COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智能体 ID（扣子智能体编辑页 URL 中 bot 后面的数字）
COZE_BOT_ID=7694865098007035940

# 接口域名：国内版 https://api.coze.cn ；国际版 https://api.coze.com
COZE_API_BASE=https://api.coze.cn

# ---------- 可选配置（有默认值）----------

# 人工接管面板（/admin/takeover.html）的管理口令。
# 不配置时 /api/pending、/api/session/*、/api/resolve 一律返回 503（默认拒绝），
# 正常聊天不受影响；配置后接管页首次打开会提示输入口令并存进 sessionStorage。
# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# ADMIN_TOKEN=

# 转人工时随接管队列一起保留的上下文轮数（默认 5）。
# 人工接手时按「最近 N 组问答」展示，超出的更早轮次自动丢弃。
# HANDOFF_CONTEXT_ROUNDS=5

# 本地监听端口与地址
PORT=3000
HOST=0.0.0.0

# 单次请求体上限（字节）。默认 16384（测试期放宽）；上线建议 4096。
# MAX_BODY_BYTES=4096

# 单条消息最大字符数。默认 2000（测试期放宽）；上线建议 500。
# MAX_MESSAGE_CHARS=500

# 单 IP 限流：每分钟最多 N 次提问。默认 60（测试期，连续自测不打断）；上线建议 6。
# IP_PER_MINUTE=6

# 单 IP 限流：每天最多 N 次提问。默认 2000（测试期）；上线建议 60。
# IP_PER_DAY=60

# 全站每日总量上限：所有 IP 加起来每天最多 N 次，兜底止损。
# 默认 5000（测试期）；上线建议 500。
# GLOBAL_PER_DAY=500

# 单 IP 每分钟 /api/health 上限（独立计数）。默认 120（测试期）；上线建议 30。
# HEALTH_PER_MINUTE=30

# FAQ 首问缓存开关（默认 1）。自测时设 0，确保每次都真的走模型、不被缓存回放。
# FAQ_CACHE_ENABLED=0

# 允许的额外来源（逗号分隔，不带尾斜杠）。
# 默认只允许同源；如果把前端部署在别的域名，把那个域名加进来。
# 例：ALLOWED_ORIGINS=https://your-frontend.com,https://another.com
ALLOWED_ORIGINS=

# 指定 CA 根证书包路径。一般不用填；只有当 Python 报
# "certificate verify failed" 时才需要手动指定。
# COZE_CA_BUNDLE=/etc/ssl/cert.pem

# 会话 Cookie 是否强制加 Secure。一般留空：HTTPS 部署下服务端会按
# 请求头 X-Forwarded-Proto 自动加，本地 HTTP 不加。
# COOKIE_SECURE=1

# 数值守卫开关（默认 1 开启）。设为 0 可单独关闭灰度，
# 关闭后不再校验模型答复里的数字，占位符替换仍保持开启。
# NUMERIC_GUARD_ENABLED=1

# 数值清单路径（默认 data/kb_numeric_manifest.json）。
# 知识库数字改动后重跑：python3 scripts/gen_kb_numeric_manifest.py
# KB_NUMERIC_MANIFEST=data/kb_numeric_manifest.json
