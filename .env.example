# 优眠小助手 后端代理 · 环境变量示例
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交到 GitHub）
# 所有变量都有默认值，下面只列出需要覆盖的场景。

# ---------- 必须配置 ----------

# 扣子个人访问令牌（PAT，pat_ 开头）
# 生成地址：https://www.coze.cn/open  →  个人访问令牌
# 必须勾选：Chat（对话）
COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智能体 ID（扣子智能体编辑页 URL 中 bot 后面的数字）
COZE_BOT_ID=7694865098007035940

# 接口域名：国内版 https://api.coze.cn ；国际版 https://api.coze.com
COZE_API_BASE=https://api.coze.cn

# ---------- 可选配置（有默认值）----------

# 本地监听端口与地址
PORT=3000
HOST=0.0.0.0

# 单次请求体上限（字节）。防止有人 POST 超大 body 消耗内存。
MAX_BODY_BYTES=4096

# 单条消息最大字符数。超过会被拒绝，防止刷长文本消耗扣子额度。
MAX_MESSAGE_CHARS=500

# 单 IP 限流：每分钟最多 N 次提问
IP_PER_MINUTE=6

# 单 IP 限流：每天最多 N 次提问
IP_PER_DAY=60

# 全站每日总量上限：所有 IP 加起来每天最多 N 次，兜底止损
GLOBAL_PER_DAY=500

# 允许的额外来源（逗号分隔，不带尾斜杠）。
# 默认只允许同源；如果把前端部署在别的域名，把那个域名加进来。
# 例：ALLOWED_ORIGINS=https://your-frontend.com,https://another.com
ALLOWED_ORIGINS=

# 指定 CA 根证书包路径。一般不用填；只有当 Python 报
# "certificate verify failed" 时才需要手动指定。
# COZE_CA_BUNDLE=/etc/ssl/cert.pem

# 会话 Cookie 是否强制加 Secure。一般留空：HTTPS 部署下服务端会按
# 请求头 X-Forwarded-Proto 自动加，本地 HTTP 不加。
# COOKIE_SECURE=1
