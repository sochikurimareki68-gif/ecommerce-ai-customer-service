    { "id": "R05", "expect_branch": "退换售后", "input": "我要投诉", "expect_any": ["投诉", "人工", "处理"] },

    { "id": "D01", "expect_branch": "优惠活动", "input": "现在有什么优惠活动？", "expect_any": ["优惠", "活动"] },
    { "id": "D02", "expect_branch": "优惠活动", "input": "有满减吗？", "expect_any": ["满减"] },
    { "id": "D03", "expect_branch": "优惠活动", "input": "优惠券在哪里领？", "expect_any": ["优惠券", "券", "领"] },
    { "id": "D04", "expect_branch": "优惠活动", "input": "会员有折扣吗？", "expect_any": ["会员", "折扣", "优惠"] },
    { "id": "D05", "expect_branch": "优惠活动", "input": "双十一有活动吗？", "expect_any": ["活动", "优惠"] },

    { "id": "F01", "expect_branch": "其他兜底", "input": "你好", "expect_any": ["欢迎", "您好"] },
    { "id": "F02", "expect_branch": "其他兜底", "input": "能便宜点吗？", "expect_any": ["活动价", "优惠券", "不议价", "价格"] },
